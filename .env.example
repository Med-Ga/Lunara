# Copy to .env and fill in. Never commit real values.

# Supabase: Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only: secret key (sb_secret_...) or legacy service_role key
SUPABASE_SECRET_KEY=
# Scripts/tests only: Connect > Session pooler connection string (with password)
SUPABASE_DB_URL=

# Stripe TEST mode only (sk_test_ / pk_test_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Signing secret of the deployed webhook endpoint (npm run stripe:webhook -- <origin>)
STRIPE_WEBHOOK_SECRET=

# Canonical origin used for Checkout return URLs and CSRF checks
APP_ORIGIN=http://localhost:3000
# Session policy (proposed OD-01 defaults)
SESSION_HEARTBEAT_MS=5000
SESSION_LEASE_MS=15000
